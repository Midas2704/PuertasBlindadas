# Copiar como .env. No reutilizar credenciales del VPS.
LOCAL_POSTGRES_USER=pblindadas_local
LOCAL_POSTGRES_PASSWORD=REEMPLAZAR_POR_CLAVE_LOCAL_ALEATORIA
LOCAL_POSTGRES_DB=pblindadas_local
LOCAL_BACKEND_PORT=3001
LOCAL_FRONTEND_PORT=8081
# Sólo para la presentación local. Mantener ambos valores en false fuera del equipo de demostración.
MODO_DEMOSTRACION=false
VITE_MODO_DEMOSTRACION=false

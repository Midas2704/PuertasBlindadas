DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5433/pblindadas_finanzas?schema=public"
PORT=3000
HOST=127.0.0.1
# Sólo desarrollo local. En producción se exige reemplazar la interfaz.
M4_CORREO=desarrollo
M4_URL_VISTA=http://127.0.0.1:5174
M4_ORIGENES=http://127.0.0.1:5174,http://localhost:5174
# Política técnica vigente: ver documentacion/ESTADO_TECNICO_VIGENTE.md
M4_LONGITUD_MINIMA=12
M4_HISTORIAL=5
M4_VIGENCIA_DIAS=90
M4_TEMPORAL_MINUTOS=60
M4_SESION_MINUTOS=60
M4_INACTIVIDAD_MINUTOS=10
M4_RECUPERACION_MINUTOS=20
M4_INTENTOS=3
M4_BLOQUEO_MINUTOS=10
M4_BLOQUEOS=3
# Opcional y sólo para el primer seed de desarrollo. Si se omite, se genera una clave aleatoria una sola vez.
M4_CLAVE_INICIAL=
# Aprovisionamiento explícito de la cuenta raíz en el servidor. Nunca guardar la clave real en Git.
M4_CLAVE_RAIZ=
M4_CORREO_RAIZ=

# Almacenamiento documental (Bloque 4.3). No habilita endpoints ni conexiones al iniciar.
# R2: STORAGE_REGION=auto y endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com.
# S3: omitir STORAGE_ENDPOINT para usar el endpoint AWS de la región y roles IAM.
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
# Obligatorio para R2; en AWS se omite para usar la cadena de credenciales/IAM.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_TIMEOUT_MS=30000
STORAGE_MAX_ATTEMPTS=3
# Sólo para emuladores locales aislados; nunca habilitar con hosts externos.
STORAGE_ALLOW_LOCAL_ENDPOINT=false
# Declarar true únicamente cuando el bucket S3 real tenga la capacidad activada.
STORAGE_S3_VERSIONING_ENABLED=false
STORAGE_S3_OBJECT_LOCK_ENABLED=false
STORAGE_S3_KMS_ENABLED=false
